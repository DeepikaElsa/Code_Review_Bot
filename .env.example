# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT
# Copy to .env (git-ignored). Everything here has a working default; you only
# need Supabase values if you want to test the login flow locally.
# ─────────────────────────────────────────────────────────────────────────────

# --- Inference: local Ollama, no key needed ---
CRB_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
CRB_MODEL=qwen2.5-coder:7b
CRB_FAST_MODEL=llama3.2:3b
CRB_DEFAULT_MODEL_KEY=quality

# --- Auth: off by default for local dev (open app, no login wall) ---
CRB_REQUIRE_AUTH=false
# To test login locally, set the two below (from your Supabase project) and
# flip CRB_REQUIRE_AUTH=true:
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Verify-and-repair ---
CRB_VERIFY=true
CRB_MAX_REPAIR_ATTEMPTS=2

# --- Server ---
CRB_PORT=5000
CRB_CORS_ORIGINS=*

# --- Frontend (Vite, build-time) ---
VITE_API_URL=http://localhost:5000
# Auth off locally unless you set these:
VITE_REQUIRE_AUTH=false
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
