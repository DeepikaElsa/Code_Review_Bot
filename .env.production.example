# ─────────────────────────────────────────────────────────────────────────────
# HOSTED / PRODUCTION
# Split across two hosts:
#   BACKEND  vars go in your backend host (Render / Railway / Fly).
#   FRONTEND vars (VITE_*) go in Vercel/Netlify build settings.
# NEVER commit real values. NEVER expose SUPABASE_JWT_SECRET to the frontend.
# ─────────────────────────────────────────────────────────────────────────────

# ============================ BACKEND ============================

# --- Inference provider: pick ONE block ---

# Option A — Ollama Cloud (least change; reuses your existing models)
CRB_PROVIDER=ollama
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your-ollama-cloud-key            # https://ollama.com/settings/keys
CRB_MODEL=gpt-oss:120b-cloud
CRB_MODEL_LABEL=GPT-OSS 120B
CRB_FAST_MODEL=gpt-oss:20b-cloud
CRB_FAST_MODEL_LABEL=GPT-OSS 20B
CRB_DEFAULT_MODEL_KEY=quality

# Option B — Groq (OpenAI-compatible, very fast free tier). Uncomment to use.
# CRB_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your-groq-key                   # https://console.groq.com/keys
# CRB_MODEL=llama-3.3-70b-versatile              # check console for exact ids
# CRB_MODEL_LABEL=Llama 3.3 70B
# CRB_FAST_MODEL=llama-3.1-8b-instant
# CRB_FAST_MODEL_LABEL=Llama 3.1 8B
# CRB_DEFAULT_MODEL_KEY=quality

# --- Auth (required in production) ---
CRB_REQUIRE_AUTH=true
# Supabase → Project Settings → API → JWT Secret. Backend-only. Keep it secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Security ---
# Exact frontend origin(s), comma-separated. Do NOT use * in production.
CRB_CORS_ORIGINS=https://your-app.vercel.app
CRB_VERIFY=true
CRB_DEBUG=false
# PORT is set automatically by most PaaS hosts; leave unset there.

# ============================ FRONTEND (Vite) ============================
VITE_API_URL=https://your-backend.onrender.com
VITE_REQUIRE_AUTH=true
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key      # safe to expose; it is public
